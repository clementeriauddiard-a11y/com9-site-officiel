# ─── Dépendances ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Next.js ──────────────────────────────────────────────────────────────────
/.next/
/out/
/build

# ─── Variables d'environnement ────────────────────────────────────────────────
# Ne jamais committer les fichiers .env — ils peuvent contenir des secrets.
# Tout fichier .env* est ignoré (.env, .env.local, .env.production.local,
# .env.vercel-fresh…). Seul .env.example, SANS valeur réelle, est autorisé.
.env
.env*
!.env.example

# ─── Vercel ───────────────────────────────────────────────────────────────────
.vercel

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ─── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Claude Code (outil de développement) ─────────────────────────────────────
.claude/
